{
  "uid": "avance-por-sesion",
  "title": "Avance por sesión",
  "tags": [
    "agente-iac"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "description": "Reales vs simuladas se distinguen en la columna Tipo. Fuente: bitacora/resumen.json (generado por scripts/bitacora.py).",
  "panels": [
    {
      "id": 1,
      "title": "Línea de tiempo de sesiones",
      "type": "table",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "bitacora"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "bitacora"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://bitacora-web/resumen.json",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "bitacora",
          "columns": [
            {
              "selector": "numero",
              "text": "#",
              "type": "number"
            },
            {
              "selector": "fecha",
              "text": "Fecha",
              "type": "string"
            },
            {
              "selector": "fase",
              "text": "Fase",
              "type": "string"
            },
            {
              "selector": "tema",
              "text": "Tema",
              "type": "string"
            },
            {
              "selector": "tipo",
              "text": "Tipo",
              "type": "string"
            },
            {
              "selector": "rama",
              "text": "Rama",
              "type": "string"
            },
            {
              "selector": "commit",
              "text": "Commit",
              "type": "string"
            }
          ]
        }
      ],
      "description": "Una fila por sesión ordenada por fecha. SIMULADO = reconstruida, sin evidencia verificable.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tipo"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SIMULADO": {
                        "color": "orange",
                        "text": "SIMULADO"
                      },
                      "REAL": {
                        "color": "green",
                        "text": "REAL"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Fecha",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Temas del curso: aplicados vs pendientes",
      "type": "piechart",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "bitacora"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "bitacora"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://bitacora-web/resumen.json",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "totales",
          "columns": [
            {
              "selector": "temas_aplicados",
              "text": "Aplicados",
              "type": "number"
            },
            {
              "selector": "temas_pendientes",
              "text": "Pendientes",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Solo cuentan temas aplicados en sesiones reales.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Aplicados"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pendientes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
