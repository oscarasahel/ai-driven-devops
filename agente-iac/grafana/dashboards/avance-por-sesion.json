    {
      "id": 8,
      "title": "SLI del pipeline (builds buenos / builds totales)",
      "type": "stat",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "bitacora"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "bitacora"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://bitacora-web/pipeline-eventos.json",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "sli",
          "columns": [
            {
              "selector": "sli_pct",
              "text": "SLI %",
              "type": "number"
            },
            {
              "selector": "slo_pct",
              "text": "SLO %",
              "type": "number"
            },
            {
              "selector": "builds",
              "text": "Builds",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Bueno = success o rechazo humano; malo = failure. SLO 90 %. Con pocos builds el valor es muy sensible. Fuente: scripts/eventos_pipeline.py.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^SLI %$/",
          "values": false
        }
      }
