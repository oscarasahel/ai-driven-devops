# Copiar a .env (nunca commitear). Solo valores ficticios.
# --- Emulador AWS ---
EMULATOR_PORT=9297
EMULATOR_TELEMETRY=off        # se aplica también con el flag --telemetry off en el compose
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297
# Las credenciales reales del emulador las genera él mismo en ~/.aws/emulator/9297/emulator_credentials
# Ninguna credencial AWS real va en este proyecto.
# --- Jenkins (fase 5) ---
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=cambiar-en-local
# --- Grafana (fase 7) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-en-local
